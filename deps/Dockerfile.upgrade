FROM golang:1.25-bookworm

# PR #416 uses GCC and C++20 on Linux. Debian bookworm matches its
# devcontainer distribution and supplies GCC 12 and Python 3.11.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ccache curl git jq ninja-build python3 python3-venv \
    wget xz-utils pkg-config g++-aarch64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

ENV DEPOT_TOOLS_UPDATE=0
RUN useradd --uid 1000 --create-home builder
USER builder
WORKDIR /workspace
