ARG ALPINE_VERSION=3.24.1
FROM alpine:${ALPINE_VERSION}
# Consumers build with their distribution's compiler and the packaged libc++.
# Use the distribution defaults together: edge's compiler-rt moves to new LLVM
# majors before older versioned clang packages disappear from its repository.
RUN apk add --no-cache build-base clang lld compiler-rt go python3 linux-headers binutils
ENV CC=clang CXX=clang++
WORKDIR /workspace
