--- a/build/config/BUILDCONFIG.gn
+++ b/build/config/BUILDCONFIG.gn
@@ -335,6 +335,11 @@
 is_fuchsia = current_os == "fuchsia"
 is_ios = current_os == "ios"
 is_linux = current_os == "linux"
+declare_args() {
+  use_musl = false
+}
+# Build-time executables and proc macros keep the host's glibc ABI.
+is_musl = use_musl && is_linux
 is_mac = current_os == "mac"
 is_wasm = current_os == "emscripten"
 is_watchos = current_os == "watchos"
--- a/build/config/rust.gni
+++ b/build/config/rust.gni
@@ -199,7 +199,14 @@
 # (see '*_toolchain_supports_platform above') to enable experimentation with
 # other toolchains.
 rust_abi_target = ""
-if (is_linux || is_chromeos) {
+if (is_musl) {
+  assert(current_cpu == "x64" || current_cpu == "arm64")
+  if (current_cpu == "arm64") {
+    rust_abi_target = "aarch64-unknown-linux-musl"
+  } else {
+    rust_abi_target = "x86_64-unknown-linux-musl"
+  }
+} else if (is_linux || is_chromeos) {
   if (current_cpu == "arm64") {
     rust_abi_target = "aarch64-unknown-linux-gnu"
   } else if (current_cpu == "x86") {
--- a/build/config/compiler_cpu_abi.gn
+++ b/build/config/compiler_cpu_abi.gn
@@ -364,3 +364,20 @@
     cpu_abi_ldflags += [ "-m64" ]
   }
 }
+
+# Apply musl only to the packaged library, never to host build tools.
+if (is_musl) {
+  _musl_cflags = []
+  foreach(flag, cpu_abi_cflags) {
+    _musl_cflags += [ string_replace(flag, "linux-gnu", "linux-musl") ]
+  }
+  cpu_abi_cflags = []
+  cpu_abi_cflags = _musl_cflags
+  _musl_ldflags = []
+  foreach(flag, cpu_abi_ldflags) {
+    _musl_ldflags += [ string_replace(flag, "linux-gnu", "linux-musl") ]
+  }
+  cpu_abi_ldflags = []
+  cpu_abi_ldflags = _musl_ldflags
+  cpu_abi_defines += [ "V8GO_USE_MUSL" ]
+}
--- a/build/toolchain/linux/BUILD.gn
+++ b/build/toolchain/linux/BUILD.gn
@@ -396,3 +396,15 @@
     is_clang = false
   }
 }
+
+# Separate labels are required when host and target CPUs match but libc differs.
+foreach(cpu, [ "x64", "arm64" ]) {
+  clang_toolchain("clang_${cpu}_glibc") {
+    toolchain_args = {
+      current_cpu = cpu
+      current_os = "linux"
+      use_musl = false
+      target_sysroot = ""
+    }
+  }
+}
